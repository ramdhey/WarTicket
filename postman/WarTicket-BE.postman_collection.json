    {
      "name": "👤 User — Auth",
      "description": "Requires valid accessToken",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/profile",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('accessToken', '');",
                  "pm.collectionVariables.set('refreshToken', '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Updated Name",
                  "type": "text"
                },
                {
                  "key": "timezone",
                  "value": "Asia/Jakarta",
                  "type": "text"
                },
                {
                  "key": "preferences",
                  "value": "[\"WORKSHOP\"]",
                  "type": "text"
                },
                {
                  "key": "avatar",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "profile"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "🎪 User — Events (Browse)",
      "description": "Public browse. Auth optional for smart sort.",
      "item": [
        {
          "name": "List All Events",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.events && json.data.events.length > 0) {",
                  "  var e = json.data.events[0];",
                  "  pm.collectionVariables.set('eventId', e.id);",
                  "  if (e.timeSlots && e.timeSlots.length > 0) {",
                  "    pm.collectionVariables.set('timeSlotId', e.timeSlots[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Search Events by Keyword",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events?search=rock&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "rock"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Filter Events by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events?category=CONCERT&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "CONCERT"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Smart Sort (by Preferences — needs auth)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events?sort=smart&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "smart"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Get Event Detail + Slot Availability",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events/{{eventId}}"
          }
        }
      ]
    },
    {
      "name": "🎟️ User — Bookings",
      "description": "Requires valid accessToken",
      "item": [
        {
          "name": "Book a Spot (1–5 qty)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.booking) {",
                  "  pm.collectionVariables.set('bookingId', json.data.booking.id);",
                  "  pm.collectionVariables.set('ticketId', json.data.booking.id);",
                  "} else if (json.data && json.data.waitlist) {",
                  "  console.log('Added to waitlist at position: ' + json.data.waitlist.position);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bookings",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timeSlotId\": \"{{timeSlotId}}\",\n  \"quantity\": 2\n}"
            }
          }
        },
        {
          "name": "My Bookings (Upcoming / Past / Cancelled)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "var all = json.data.upcoming.concat(json.data.past).concat(json.data.cancelled);",
                  "if (all.length > 0) {",
                  "  pm.collectionVariables.set('bookingId', all[0].id);",
                  "  pm.collectionVariables.set('ticketId', all[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bookings/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Partial Cancel (Reduce Qty — e.g. booked 4, cancel 2)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/bookings/{{bookingId}}/reduce",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancelQuantity\": 1\n}"
            }
          }
        },
        {
          "name": "Full Cancel Booking",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/bookings/{{bookingId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Undo Cancellation (5-min window)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bookings/{{bookingId}}/undo",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "📋 User — Waitlist",
      "description": "Requires valid accessToken",
      "item": [
        {
          "name": "Join Waitlist",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/waitlists",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timeSlotId\": \"{{timeSlotId}}\",\n  \"quantity\": 1\n}"
            }
          }
        },
        {
          "name": "My Waitlist Entries",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/waitlists/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Get Slot Waitlist",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/waitlists/slot/{{timeSlotId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "🔔 User — Notifications",
      "description": "Requires valid accessToken",
      "item": [
        {
          "name": "My Notifications (All)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.notifications && json.data.notifications.length > 0) {",
                  "  pm.collectionVariables.set('notificationId', json.data.notifications[0].id);",
                  "  console.log('Unread count: ' + json.data.unreadCount);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/notifications/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "My Notifications (Unread Only)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/notifications/me?unread=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "me"
              ],
              "query": [
                {
                  "key": "unread",
                  "value": "true"
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Mark Notification as Read",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/notifications/{{notificationId}}/read",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Mark All Notifications as Read",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/notifications/read-all",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        }
      ]
    },
