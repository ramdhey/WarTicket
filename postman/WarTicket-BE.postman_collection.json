    {
      "name": "🎫 Admin — Ticket Check-in",
      "description": "Requires adminAccessToken (role: ADMIN). ticketId = Booking ID.",
      "item": [
        {
          "name": "Verify Ticket (scan barcode → check validity)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data) {",
                  "  var d = json.data;",
                  "  console.log('Ticket: ' + d.ticketId);",
                  "  console.log('Valid: ' + d.isValid + ' | CheckedIn: ' + d.isCheckedIn);",
                  "  console.log('Holder: ' + d.holder.name + ' (' + d.holder.email + ')');",
                  "  console.log('Event: ' + d.event.title);",
                  "  console.log('Slot: ' + d.slot.label);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/tickets/{{ticketId}}/verify",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ]
          }
        },
        {
          "name": "Check-in Ticket (mark as used)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success) {",
                  "  console.log('✅ ' + json.data.message);",
                  "  console.log('CheckedInAt: ' + json.data.checkedInAt);",
                  "} else {",
                  "  console.log('❌ ' + json.error.message);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/tickets/{{ticketId}}/checkin",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ]
          }
        },
        {
          "name": "Check-in Again (should fail — ALREADY_CHECKED_IN)",
          "request": {
