                  "var json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.collectionVariables.set('eventId', json.data.id);",
                  "  if (json.data.timeSlots && json.data.timeSlots.length > 0) {",
                  "    pm.collectionVariables.set('timeSlotId', json.data.timeSlots[0].id);",
                  "  }",
                  "  console.log('Event created: ' + json.data.id);",
                  "}"
                ]
